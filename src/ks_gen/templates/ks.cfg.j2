# Generated by ks-gen v{{ version }} on {{ generated_at }}
# Source profile: xccdf_org.ssgproject.content_profile_{{ cfg.meta.profile }}
# DO NOT EDIT by hand — regenerate with `ks-gen gen --config <yaml>`

text
lang {{ cfg.system.locale }}
keyboard {{ cfg.system.keyboard }}
timezone {{ cfg.system.timezone }} --utc

{% for iface in cfg.network.interfaces -%}
network --device={{ iface.device }} --bootproto={{ iface.bootproto }}{% if iface.bootproto == 'static' %} --ip={{ iface.ip }} --netmask={{ iface.netmask }} --gateway={{ iface.gateway }}{% if iface.nameservers %} --nameserver={{ iface.nameservers | join(',') }}{% endif %}{% endif %} --hostname={{ cfg.system.hostname }} --onboot={{ 'yes' if iface.onboot else 'no' }}
{% endfor %}
{% if cfg.install.source.value == 'network' -%}
url --url="{{ cfg.install.baseos_url }}"
repo --name=AppStream --baseurl="{{ cfg.install.appstream_url }}"
{% endif %}

rootpw --lock
{% set _admin = cfg.user.admin -%}
{% if _admin.password -%}
user --name={{ _admin.name }} --password={{ _admin.password }} --iscrypted --groups={{ _admin.groups | join(',') }} --gecos="{{ _admin.gecos }}" --shell={{ _admin.shell }}
{% else -%}
user --name={{ _admin.name }} --lock --groups={{ _admin.groups | join(',') }} --gecos="{{ _admin.gecos }}" --shell={{ _admin.shell }}
{% endif -%}
{% set _wipe_targets = ([cfg.disk.target] + cfg.disk.data_disks | selectattr('wipe') | map(attribute='target') | list) | reject('none') | list -%}
{% if cfg.disk.target -%}
ignoredisk --only-use={{ _wipe_targets | join(',') }}
{% endif -%}
{% set BOOT_DRIVE = (' --boot-drive=' ~ cfg.disk.target) if cfg.disk.target else '' -%}
{% if cfg.disk.bootloader_password -%}
bootloader --location=mbr{{ BOOT_DRIVE }} --append="audit=1 audit_backlog_limit=8192{% if cfg.kernel_fips %} fips=1{% endif %}" --password="{{ cfg.disk.bootloader_password }}"
{% else -%}
bootloader --location=mbr{{ BOOT_DRIVE }} --append="audit=1 audit_backlog_limit=8192{% if cfg.kernel_fips %} fips=1{% endif %}"
{% endif %}

{% if cfg.disk.wipe -%}
zerombr
{% if cfg.disk.target -%}
clearpart --all --initlabel --drives={{ _wipe_targets | join(',') }}
{% else -%}
clearpart --all --initlabel
{% endif -%}
{# AL10's installer labels a wiped disk GPT whatever the firmware, and GPT
   under BIOS needs a 1 MiB biosboot partition for GRUB's core image (#140).
   Unused under UEFI, so one layout boots either way. AL8/9 give BIOS machines
   an msdos label instead. Only with wipe: a kept label may be msdos. #}
{% if cfg.distro == "alma10" -%}
part biosboot --fstype=biosboot --size=1{% if cfg.disk.target %} --ondisk={{ cfg.disk.target }}{% endif %}

{% endif -%}
{% endif -%}

{% if cfg.disk.layout -%}
{% include 'partials/partitioning_layout.j2' %}
{% else -%}
{% include 'partials/partitioning_' ~ cfg.disk.preset.value ~ '.j2' %}
{% endif %}
{% for d in cfg.disk.data_disks if d.wipe -%}
part {{ d.mount }} --fstype={{ d.fstype }} --grow --size=1 --ondisk={{ d.target }}{% if d.fsoptions %} --fsoptions="{{ d.fsoptions }}"{% endif %}
{% endfor -%}
{% if cfg.containers.enabled %}
logvol /srv/containers --vgname={{ cfg.disk.layout.vg_name if cfg.disk.layout else 'vg_root' }} --name=containers --fstype=xfs --size={{ cfg.containers.volume.size_mib }} --fsoptions="{{ cfg.containers.volume.fsoptions }}"
{% endif %}

services --enabled=chronyd,firewalld,auditd,rsyslog,sshd
{# Local accounts only: no sss in PAM or nsswitch, and no sssd.service left
   failing at boot because nothing configured it. The STIG remediation
   derives custom/hardening from whatever profile this selects. AL10's
   authselect renamed `minimal` to `local`. A host that joins a domain
   later selects sssd itself (realm join does). #}
authselect select {{ 'local' if cfg.distro == 'alma10' else 'minimal' }} --force

%packages
{% for grp in cfg.packages.effective_base_groups %}{{ grp }}
{% endfor -%}
{% for pkg in cfg.packages.effective_required %}{{ pkg }}
{% endfor -%}
{% for pkg in rule_packages %}{{ pkg }}
{% endfor -%}
{% for pkg in cfg.packages.extra %}{{ pkg }}
{% endfor -%}
{% for pkg in cfg.packages.excluded %}-{{ pkg }}
{% endfor -%}
%end

{% if cfg.disk.luks.preset.value == 'tang' -%}
{% include 'partials/luks_tang_bind.j2' %}
{% endif -%}

%post --nochroot --erroronfail --log=/mnt/sysimage/root/ks-post-oscap-fetch.log
set -euo pipefail

# Stage tailoring.xml into the target rootfs. Runs in the installer
# environment so both network (http(s)) and the kickstart media at
# /run/install/repo (hd:LABEL=) are reachable. The chrooted oscap
# block that follows reads /root/tailoring.xml unconditionally.
ks_arg=$(awk -F'inst.ks=' 'NF>1{print $2}' /proc/cmdline | awk '{print $1}')
case "$ks_arg" in
  http://*|https://*)
    base="${ks_arg%/*}"
    curl -fsSL --retry 5 --retry-delay 3 \
      "${base}/tailoring.xml" -o /mnt/sysimage/root/tailoring.xml
    ;;
  hd:LABEL=*)
    cp /run/install/repo/tailoring.xml /mnt/sysimage/root/tailoring.xml
    ;;
  *)
    echo "ks-gen: unsupported inst.ks transport '$ks_arg' (supports http(s) and hd:LABEL=)" >&2
    exit 1
    ;;
esac
chmod 0600 /mnt/sysimage/root/tailoring.xml
%end

%post --erroronfail --log=/root/ks-post-oscap.log
set -euo pipefail

test -s /root/tailoring.xml
head -c 5 /root/tailoring.xml | grep -q '<?xml'

# Pull SCAP content up to what the repos ship before remediating (#90).
# Install media can be many SSG releases behind: the AlmaLinux 8.10 DVD carries
# 0.1.72 while the repos ship 0.1.81, and the two disagree about which crypto
# policy the stig profile expects. Without this, oscap remediates against media
# content and ks-gen's own dnf-automatic timer upgrades it minutes later, so
# every later scan judges the host against rules that never ran.
# Best-effort by design: an offline install keeps the media's content and stays
# self-consistent, which is the other correct outcome.
dnf -y upgrade scap-security-guide || \
  echo "ks-gen: could not upgrade scap-security-guide; remediating against media content" >&2

# --profile below names a profile that exists ONLY in this tailoring file, so
# a mismatched tailoring makes oscap abort — and the `|| true` would swallow
# it, leaving a green install with zero remediation. Fail closed instead: this
# block is --erroronfail, so a wrong bundle stops the install loudly.
grep -q 'id="{{ tailored_profile_id }}"' /root/tailoring.xml || {
  echo "ks-gen: /root/tailoring.xml does not define {{ tailored_profile_id }}" >&2
  echo "ks-gen: refusing to install unremediated — check the ks.cfg/tailoring pair" >&2
  exit 1
}

# --remediate can exit non-zero when rules remain failed (e.g., exception-
# disabled rules). The next %post block (ks-gen rule overrides) re-asserts
# critical state, so don't abort the install on a non-zero oscap exit.
oscap xccdf eval --remediate \
  --profile {{ tailored_profile_id }} \
  --fetch-remote-resources \
  --tailoring-file /root/tailoring.xml \
  --results-arf /root/oscap-remediation-results.xml \
  --report /root/oscap-remediation-report.html \
  /usr/share/xml/scap/ssg/content/{{ cfg.meta.scap_content }} || true
%end

%post --erroronfail --log=/root/ks-post.log
set -euxo pipefail

{% for block in post_blocks %}
# ===== {{ block.rule_id if block.rule_id is defined else 'block' }} =====
{{ block.body if block.body is defined else block }}

{% endfor -%}

{% for block in cfg.custom_post -%}
# ===== custom_post =====
{{ block }}

{% endfor -%}
%end

{# Its own %post, after the one above, so it covers every account made there
   (the admin's useradd fallback, container users, custom_post) and a
   custom_post block that exits early or changes shell options can't skip it.
   Keep the locked test in step with create-rootless-user.sh, which does the
   same for accounts made after install. #}
%post --erroronfail --log=/root/ks-post-aging.log
set -euxo pipefail

# ===== key-only account aging (#139) =====
# The STIG remediation can set PASS_MAX_DAYS 60 and INACTIVE=35 (AL10's does),
# and useradd gives every later account those limits. A key-only account can
# never change its password, so sshd refuses it about 95 days in. Clear max age
# and inactive on regular accounts (UID_MIN..UID_MAX, first value wins) whose
# password field is only ! and *, with no hash behind the lock to unlock into.
# The STIG's per-account aging checks skip locked accounts: no new finding.
# Captured first, so set -e stops the install if awk fails.
key_only=$(awk -F: '
  FILENAME == "/etc/login.defs" {
    split($0, f, " ")
    if (f[1] == "UID_MIN" && lo == "") lo = f[2] + 0
    if (f[1] == "UID_MAX" && hi == "") hi = f[2] + 0
    next
  }
  FILENAME == "/etc/passwd" {
    if ($3 >= (lo == "" ? 1000 : lo) && $3 <= (hi == "" ? 60000 : hi)) regular[$1] = 1
    next
  }
  ($1 in regular) && $2 ~ /^[!*]+$/ { print $1 }
' /etc/login.defs /etc/passwd /etc/shadow)
for u in $key_only; do
  chage -M 99999 -I -1 "$u"
done
%end

reboot --eject
