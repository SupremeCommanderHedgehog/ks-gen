# serializer version: 1
# name: test_data_disks_preserve_label[ks.cfg]
  '''
  # Generated by ks-gen vSNAP on SNAP
  # Source profile: xccdf_org.ssgproject.content_profile_stig
  # DO NOT EDIT by hand — regenerate with `ks-gen gen --config <yaml>`
  
  text
  lang en_US.UTF-8
  keyboard us
  timezone UTC --utc
  
  network --device=link --bootproto=dhcp --hostname=preserve-label.example.com --onboot=yes
  
  rootpw --lock
  user --name=opsadmin --lock --groups=wheel --gecos="" --shell=/bin/bash
  ignoredisk --only-use=sda
  bootloader --location=mbr --boot-drive=sda --append="audit=1 audit_backlog_limit=8192"
  
  zerombr
  clearpart --all --initlabel --drives=sda
  part /boot/efi --fstype=efi --size=1024 --asprimary --ondisk=sda
  part /boot --fstype=xfs --size=1024 --fsoptions="nodev,nosuid" --asprimary --ondisk=sda
  part pv.01 --grow --size=1 --ondisk=sda
  volgroup vg_root pv.01
  logvol /             --vgname=vg_root --name=root     --fstype=xfs --size=15360
  logvol /home         --vgname=vg_root --name=home     --fstype=xfs --size=5120  --fsoptions="nodev,nosuid"
  logvol /tmp          --vgname=vg_root --name=tmp      --fstype=xfs --size=3072  --fsoptions="nodev,nosuid,noexec"
  logvol /var          --vgname=vg_root --name=var      --fstype=xfs --size=10240 --fsoptions="nodev"
  logvol /var/log      --vgname=vg_root --name=varlog   --fstype=xfs --size=5120  --fsoptions="nodev,nosuid,noexec"
  logvol /var/log/audit --vgname=vg_root --name=varlogaudit --fstype=xfs --size=3072 --fsoptions="nodev,nosuid,noexec"
  logvol /var/tmp      --vgname=vg_root --name=vartmp   --fstype=xfs --size=2048  --fsoptions="nodev,nosuid,noexec"
  logvol swap          --vgname=vg_root --name=swap     --fstype=swap --recommended
  
  services --enabled=chronyd,firewalld,auditd,rsyslog,sshd
  authselect select sssd --force
  
  %packages
  @^minimal-environment
  @standard
  scap-security-guide
  openscap-scanner
  aide
  audit
  rsyslog
  chrony
  firewalld
  sudo
  policycoreutils-python-utils
  dnf-automatic
  dnf-utils
  -telnet-server
  -rsh-server
  -tftp-server
  -vsftpd
  -ypserv
  %end
  
  %post --nochroot --erroronfail --log=/mnt/sysimage/root/ks-post-oscap-fetch.log
  set -euo pipefail
  
  # Stage tailoring.xml into the target rootfs. Runs in the installer
  # environment so both network (http(s)) and the kickstart media at
  # /run/install/repo (hd:LABEL=) are reachable. The chrooted oscap
  # block that follows reads /root/tailoring.xml unconditionally.
  ks_arg=$(awk -F'inst.ks=' 'NF>1{print $2}' /proc/cmdline | awk '{print $1}')
  case "$ks_arg" in
    http://*|https://*)
      base="${ks_arg%/*}"
      curl -fsSL --retry 5 --retry-delay 3 \
        "${base}/tailoring.xml" -o /mnt/sysimage/root/tailoring.xml
      ;;
    hd:LABEL=*)
      cp /run/install/repo/tailoring.xml /mnt/sysimage/root/tailoring.xml
      ;;
    *)
      echo "ks-gen: unsupported inst.ks transport '$ks_arg' (supports http(s) and hd:LABEL=)" >&2
      exit 1
      ;;
  esac
  chmod 0600 /mnt/sysimage/root/tailoring.xml
  %end
  
  %post --erroronfail --log=/root/ks-post-oscap.log
  set -euo pipefail
  
  test -s /root/tailoring.xml
  head -c 5 /root/tailoring.xml | grep -q '<?xml'
  
  # Pull SCAP content up to what the repos ship before remediating (#90).
  # Install media can be many SSG releases behind: the AlmaLinux 8.10 DVD carries
  # 0.1.72 while the repos ship 0.1.81, and the two disagree about which crypto
  # policy the stig profile expects. Without this, oscap remediates against media
  # content and ks-gen's own dnf-automatic timer upgrades it minutes later, so
  # every later scan judges the host against rules that never ran.
  # Best-effort by design: an offline install keeps the media's content and stays
  # self-consistent, which is the other correct outcome.
  dnf -y upgrade scap-security-guide || \
    echo "ks-gen: could not upgrade scap-security-guide; remediating against media content" >&2
  
  # --profile below names a profile that exists ONLY in this tailoring file, so
  # a mismatched tailoring makes oscap abort — and the `|| true` would swallow
  # it, leaving a green install with zero remediation. Fail closed instead: this
  # block is --erroronfail, so a wrong bundle stops the install loudly.
  grep -q 'id="xccdf_ks-gen_profile_tailored"' /root/tailoring.xml || {
    echo "ks-gen: /root/tailoring.xml does not define xccdf_ks-gen_profile_tailored" >&2
    echo "ks-gen: refusing to install unremediated — check the ks.cfg/tailoring pair" >&2
    exit 1
  }
  
  # --remediate can exit non-zero when rules remain failed (e.g., exception-
  # disabled rules). The next %post block (ks-gen rule overrides) re-asserts
  # critical state, so don't abort the install on a non-zero oscap exit.
  oscap xccdf eval --remediate \
    --profile xccdf_ks-gen_profile_tailored \
    --fetch-remote-resources \
    --tailoring-file /root/tailoring.xml \
    --results-arf /root/oscap-remediation-results.xml \
    --report /root/oscap-remediation-report.html \
    /usr/share/xml/scap/ssg/content/ssg-almalinux9-ds.xml || true
  %end
  
  %post --erroronfail --log=/root/ks-post.log
  set -euxo pipefail
  
  # ===== skel_init_files =====
  # Tighten /etc/skel's init files to 0740 or stricter, before any home is
  # created from it here (STIG var_user_initialization_files_regex) (#131)
  # Never fatal: admin_user_and_keys runs after this, and must.
  if [ -d /etc/skel ]; then
    LC_ALL=C find /etc/skel/ -maxdepth 1 -type f -regextype posix-extended \
      -regex '.*/\.[[:alnum:]_ -]+' -perm /7037 \
      -exec chmod u-s,g-wxs,o-rwxt {} + \
      || echo 'ks-gen: warning: could not tighten /etc/skel init files' >&2
  fi
  
  # ===== admin_user_and_keys =====
  # Create admin user (idempotent)
  if ! getent passwd opsadmin >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --groups wheel --comment "" opsadmin
  fi
  passwd -l opsadmin
  
  install -d -m 700 -o opsadmin -g opsadmin /home/opsadmin/.ssh
  cat > /home/opsadmin/.ssh/authorized_keys <<'__KS_GEN_EOF__'
  ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAITESTKEYprlbl ops@bastion
  __KS_GEN_EOF__
  chmod 600 /home/opsadmin/.ssh/authorized_keys
  chown opsadmin:opsadmin /home/opsadmin/.ssh/authorized_keys
  restorecon -R /home/opsadmin/.ssh
  
  # Sudoers
  cat > /etc/sudoers.d/00-ks-gen-admin <<'__KS_GEN_EOF__'
  opsadmin ALL=(ALL) NOPASSWD: ALL
  __KS_GEN_EOF__
  chmod 440 /etc/sudoers.d/00-ks-gen-admin
  visudo -cf /etc/sudoers.d/00-ks-gen-admin
  
  # ===== auditd_actions =====
  # Re-assert auditd actions
  sed -i -E 's|^disk_full_action.*|disk_full_action = SUSPEND|' /etc/audit/auditd.conf
  sed -i -E 's|^disk_error_action.*|disk_error_action = SUSPEND|' /etc/audit/auditd.conf
  sed -i -E 's|^max_log_file_action.*|max_log_file_action = ROTATE|' /etc/audit/auditd.conf
  
  # ===== banner_text =====
  # Civilian-equivalent login banner
  cat > /etc/issue <<'__KS_GEN_EOF__'
  WARNING: This is a private computer system. Unauthorized access is
  prohibited. All activity on this system may be monitored and logged.
  Use of this system constitutes consent to such monitoring.
  __KS_GEN_EOF__
  chmod 644 /etc/issue
  cat > /etc/issue.net <<'__KS_GEN_EOF__'
  WARNING: This is a private computer system. Unauthorized access is
  prohibited. All activity on this system may be monitored and logged.
  Use of this system constitutes consent to such monitoring.
  __KS_GEN_EOF__
  chmod 644 /etc/issue.net
  cat > /etc/motd <<'__KS_GEN_EOF__'
  WARNING: This is a private computer system. Unauthorized access is
  prohibited. All activity on this system may be monitored and logged.
  Use of this system constitutes consent to such monitoring.
  __KS_GEN_EOF__
  chmod 644 /etc/motd
  if [ -d /etc/dconf ]; then  # GDM greeter banner (/etc/dconf/db/gdm.d/01-ks-gen-banner)
    mkdir -p /etc/dconf/db/gdm.d
    cat > /etc/dconf/db/gdm.d/01-ks-gen-banner <<'__KS_GEN_EOF__'
  [org/gnome/login-screen]
  banner-message-enable=true
  banner-message-text='WARNING: This is a private computer system. Unauthorized access is\nprohibited. All activity on this system may be monitored and logged.\nUse of this system constitutes consent to such monitoring.'
  __KS_GEN_EOF__
    chmod 0644 /etc/dconf/db/gdm.d/01-ks-gen-banner
    dconf update || true
  fi
  
  # ===== crypto_policy =====
  # Apply system-wide crypto policy: MODERN (DEFAULT)
  update-crypto-policies --set DEFAULT
  # Generate any missing host keys (incl. Ed25519, not produced under FIPS)
  ssh-keygen -A
  
  # ===== data_disks_preserve =====
  mkdir -p /data
  echo "LABEL=preserve_test /data xfs nodev,nosuid 0 2" >> /etc/fstab
  mount -a
  restorecon -R /data
  
  # ===== faillock_safety =====
  # Re-assert faillock.conf in case oscap over-tightened
  sed -i -E 's/^[# ]*unlock_time *=.*/unlock_time = 900/' /etc/security/faillock.conf
  grep -q '^unlock_time' /etc/security/faillock.conf || echo 'unlock_time = 900' >> /etc/security/faillock.conf
  sed -i -E 's/^[# ]*deny *=.*/deny = 3/' /etc/security/faillock.conf
  grep -q '^deny' /etc/security/faillock.conf || echo 'deny = 3' >> /etc/security/faillock.conf
  sed -i -E 's/^[# ]*even_deny_root.*/# even_deny_root removed by ks-gen: no/' /etc/security/faillock.conf
  
  # ===== kernel_module_blacklist =====
  # Disable specific kernel modules via modprobe install-trick
  cat > /etc/modprobe.d/ks-gen-blacklist.conf <<'__KS_GEN_EOF__'
  install usb-storage /bin/true
  install cramfs /bin/true
  install freevxfs /bin/true
  install jffs2 /bin/true
  install hfs /bin/true
  install hfsplus /bin/true
  install squashfs /bin/true
  install udf /bin/true
  __KS_GEN_EOF__
  chmod 644 /etc/modprobe.d/ks-gen-blacklist.conf
  
  # ===== package_purge =====
  # Remove disallowed packages (no-op if not installed)
  dnf -y remove telnet-server rsh-server tftp-server vsftpd ypserv || true
  
  # ===== ssh_keep_open =====
  # Pre-open SSH port in firewalld + SELinux (before sshd starts on first boot)
  firewall-offline-cmd --add-port=22/tcp
  
  # ===== ssh_config_apply =====
  # Drop-in SSH server config (active on first boot)
  install -d -m 755 /etc/ssh/sshd_config.d
  cat > /etc/ssh/sshd_config.d/00-ks-gen.conf <<'__KS_GEN_EOF__'
  Port 22
  PermitRootLogin no
  PasswordAuthentication no
  ClientAliveInterval 600
  ClientAliveCountMax 1
  MaxAuthTries 4
  UsePAM yes
  __KS_GEN_EOF__
  chmod 600 /etc/ssh/sshd_config.d/00-ks-gen.conf
  sshd -t
  
  # ===== time_servers =====
  # Chrony configuration (servers from host.yaml; STIG-compliant base)
  cat > /etc/chrony.conf <<'__KS_GEN_EOF__'
  server pool.ntp.org iburst maxpoll 16
  driftfile /var/lib/chrony/drift
  makestep 1.0 3
  rtcsync
  logdir /var/log/chrony
  # STIG: client only, no chronyc over the network (#50)
  port 0
  cmdport 0
  __KS_GEN_EOF__
  chmod 644 /etc/chrony.conf
  # chrony-wait over the local socket, not 127.0.0.1:323 (#50, KCS 7064388)
  if [ -f /usr/lib/systemd/system/chrony-wait.service ]; then
    cat > /etc/systemd/system/chrony-wait.service <<'__KS_GEN_EOF__'
  [Unit]
  Description=Wait for chrony to synchronize system clock (KCS 7064388)
  Documentation=man:chronyc(1)
  After=chronyd.service
  Requires=chronyd.service
  Before=time-sync.target
  Wants=time-sync.target
  
  [Service]
  Type=oneshot
  ExecStart=/usr/bin/chronyc waitsync 0 0.1 0.0 1
  TimeoutStartSec=180
  RemainAfterExit=yes
  StandardOutput=null
  
  [Install]
  WantedBy=multi-user.target
  __KS_GEN_EOF__
    chmod 644 /etc/systemd/system/chrony-wait.service
  fi
  
  # ===== unattended_updates =====
  # unattended_updates: nightly security via stock dnf-automatic.timer
  cat > /etc/dnf/automatic.conf <<'__KS_GEN_EOF__'
  [commands]
  upgrade_type = security
  apply_updates = yes
  reboot = never
  network_online_timeout = 60
  [emitters]
  emit_via = motd
  [base]
  debuglevel = 1
  __KS_GEN_EOF__
  chmod 644 /etc/dnf/automatic.conf
  
  mkdir -p /etc/systemd/system/dnf-automatic.timer.d
  cat > /etc/systemd/system/dnf-automatic.timer.d/ks-gen.conf <<'__KS_GEN_EOF__'
  [Timer]
  OnCalendar=
  OnCalendar=*-*-* 02:00:00
  RandomizedDelaySec=0
  __KS_GEN_EOF__
  
  systemctl daemon-reload
  systemctl enable dnf-automatic.timer
  
  # unattended_updates: monthly full update via custom dnf-automatic timer
  cat > /etc/dnf/automatic-full.conf <<'__KS_GEN_EOF__'
  [commands]
  upgrade_type = default
  apply_updates = yes
  reboot = never
  network_online_timeout = 60
  [emitters]
  emit_via = motd
  [base]
  debuglevel = 1
  __KS_GEN_EOF__
  chmod 644 /etc/dnf/automatic-full.conf
  
  cat > /etc/systemd/system/ks-gen-dnf-automatic-full.service <<'__KS_GEN_EOF__'
  [Unit]
  Description=ks-gen monthly full dnf-automatic run
  After=network-online.target
  Wants=network-online.target
  [Service]
  Type=oneshot
  ExecStart=/usr/bin/dnf-automatic /etc/dnf/automatic-full.conf
  __KS_GEN_EOF__
  
  cat > /etc/systemd/system/ks-gen-dnf-automatic-full.timer <<'__KS_GEN_EOF__'
  [Unit]
  Description=ks-gen monthly full dnf-automatic schedule
  [Timer]
  OnCalendar=Sun *-*-1..7 02:30:00
  Persistent=true
  [Install]
  WantedBy=timers.target
  __KS_GEN_EOF__
  
  systemctl daemon-reload
  systemctl enable ks-gen-dnf-automatic-full.timer
  
  # unattended_updates: reboot inside maintenance window if needs-restarting -r says so
  cat > /usr/local/sbin/ks-gen-reboot-if-needed <<'__KS_GEN_EOF__'
  #!/bin/bash
  set -euo pipefail
  if ! command -v needs-restarting >/dev/null 2>&1; then
    logger -t ks-gen -p user.err "needs-restarting missing; cannot evaluate reboot"
    exit 1
  fi
  if needs-restarting -r >/dev/null 2>&1; then
    logger -t ks-gen "no reboot needed at $(date -Is)"
    exit 0
  fi
  logger -t ks-gen "reboot needed, rebooting at $(date -Is)"
  systemctl reboot
  __KS_GEN_EOF__
  chmod 755 /usr/local/sbin/ks-gen-reboot-if-needed
  
  cat > /etc/systemd/system/ks-gen-reboot-if-needed.service <<'__KS_GEN_EOF__'
  [Unit]
  Description=ks-gen reboot if pending kernel/glibc/etc.
  [Service]
  Type=oneshot
  ExecStart=/usr/local/sbin/ks-gen-reboot-if-needed
  __KS_GEN_EOF__
  
  cat > /etc/systemd/system/ks-gen-reboot-if-needed.timer <<'__KS_GEN_EOF__'
  [Unit]
  Description=ks-gen reboot-if-needed schedule
  [Timer]
  OnCalendar=Sun *-*-* 03:00:00
  Persistent=true
  [Install]
  WantedBy=timers.target
  __KS_GEN_EOF__
  
  systemctl daemon-reload
  systemctl enable ks-gen-reboot-if-needed.timer
  
  %end
  
  %post --erroronfail --log=/root/ks-post-aging.log
  set -euxo pipefail
  
  # ===== key-only account aging (#139) =====
  # The STIG remediation can set PASS_MAX_DAYS 60 and INACTIVE=35 (AL10's does),
  # and useradd gives every later account those limits. A key-only account can
  # never change its password, so sshd refuses it about 95 days in. Clear max age
  # and inactive on regular accounts (UID_MIN..UID_MAX, first value wins) whose
  # password field is only ! and *, with no hash behind the lock to unlock into.
  # The STIG's per-account aging checks skip locked accounts: no new finding.
  # Captured first, so set -e stops the install if awk fails.
  key_only=$(awk -F: '
    FILENAME == "/etc/login.defs" {
      split($0, f, " ")
      if (f[1] == "UID_MIN" && lo == "") lo = f[2] + 0
      if (f[1] == "UID_MAX" && hi == "") hi = f[2] + 0
      next
    }
    FILENAME == "/etc/passwd" {
      if ($3 >= (lo == "" ? 1000 : lo) && $3 <= (hi == "" ? 60000 : hi)) regular[$1] = 1
      next
    }
    ($1 in regular) && $2 ~ /^[!*]+$/ { print $1 }
  ' /etc/login.defs /etc/passwd /etc/shadow)
  for u in $key_only; do
    chage -M 99999 -I -1 "$u"
  done
  %end
  
  reboot --eject
  
  '''
# ---
